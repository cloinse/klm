{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "klm-feedback-admin-local",
  "main": "src/index.js",
  "compatibility_date": "2026-08-14",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "FEEDBACK_DB",
      "database_name": "klm-feedback-db",
      "database_id": "fcd3a2bb-9d3b-4ee7-8180-c8151baf608c",
      "remote": true
    }
  ]
}

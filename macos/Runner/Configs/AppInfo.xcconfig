// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = Kontakt Library Manager

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.juanayala.kontaktLibraryManager

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Juan Ayala. All rights reserved.

// Sparkle checks only while KLM is open. Codemagic replaces the feed name for
// the Catalina artifact so the legacy Flutter engine never receives a modern
// macOS-only build.
KLM_UPDATE_FEED_NAME = appcast-macos-current
KLM_UPDATE_FEED_URL = https:/$()/raw.githubusercontent.com/cloinse/klm/main/updates/$(KLM_UPDATE_FEED_NAME).xml
KLM_SPARKLE_PUBLIC_KEY = IEM06s9BrwRuC4XtbnRQi6/hVNrTP+aN0naS8RdQNA8=
